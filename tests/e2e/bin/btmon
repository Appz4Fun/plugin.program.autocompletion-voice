#!/usr/bin/env python3
"""Fake btmon (5.87 output format) driven by trigger files.

A test drops /tmp/remote/press/<name>.frames (one hex ATVV frame per line,
128 bytes each) — that is the user holding the mic and talking. We emit what
the real UR02 does: START_SEARCH (08), ff retries until the host writes
MIC_OPEN, the audio as 6x20B+8B notifications at real-time pace, then the
button-release AUDIO_END (00).
"""
import glob, os, sys, time
R = "/tmp/remote"
os.makedirs(R + "/press", exist_ok=True)
T0 = time.time()

def out(s):
    sys.stdout.write(s); sys.stdout.flush()

def notify(handle, payload):
    ts = time.time() - T0
    out("> ACL: Handle 16 flags 0x02 dlen %d          #1 [hci0] %.6f\n" % (len(payload) + 4, ts))
    out("      ATT: Handle Value Notification (0x1b) len %d\n" % (len(payload) + 2))
    out("        Handle: 0x%04x\n          Data[%d]:\n" % (handle, len(payload)))
    for i in range(0, len(payload), 16):
        chunk = payload[i:i + 16]
        out("        %-48s %s\n" % (" ".join("%02x" % b for b in chunk), "." * len(chunk)))

out("Bluetooth monitor ver 5.87\n")
while True:
    jobs = sorted(glob.glob(R + "/press/*.frames"))
    if not jobs:
        time.sleep(0.05); continue
    job = jobs[0]
    frames = [bytes.fromhex(l.strip()) for l in open(job) if l.strip()]
    os.rename(job, job + ".done")
    for f in ("mic_open", "mic_close"):
        try: os.remove(R + "/" + f)
        except OSError: pass
    notify(0x42, b"\x08")
    deadline = time.time() + 3
    while not os.path.exists(R + "/mic_open") and time.time() < deadline:
        time.sleep(0.11); notify(0x42, b"\xff")
    if not os.path.exists(R + "/mic_open"):
        open(R + "/log", "a").write("%s: host never sent MIC_OPEN\n" % job); continue
    start = time.time()
    for n, fr in enumerate(frames):
        if os.path.exists(R + "/mic_close"):
            break
        for i in range(0, 120, 20):
            notify(0x3f, fr[i:i + 20])
        notify(0x3f, fr[120:128])
        target = start + (n + 1) * 244 / 8000.0  # 244 samples per frame @ 8 kHz
        time.sleep(max(0, target - time.time()))
    notify(0x42, b"\x00")  # button released
    open(R + "/log", "a").write("%s: streamed %d frames in %.2fs, released\n" % (job, len(frames), time.time() - start))
